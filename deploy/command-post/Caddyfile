# HTTPS for a command post. Its name resolves to the post only on the post's own Wi-Fi, so no
# certificate authority can reach it: the certificate comes from lego beforehand (DNS challenge)
# and Caddy only serves it.
{$TESEL_DOMAIN} {
	tls /certs/certificates/{$TESEL_DOMAIN}.crt /certs/certificates/{$TESEL_DOMAIN}.key

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# The base map, copied from the upstream while there is internet (refresh.sh).
	handle_path /maps/* {
		root * /srv/maps
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle {
		encode zstd gzip
		reverse_proxy tesel:8080
	}
}
