# HTTPS for a command post. Its name resolves to the post only on the post's own Wi-Fi, so no
# certificate authority can reach it: the certificate is obtained by the upstream server and
# downloaded from it by refresh.sh while there is internet (ADR-0050); Caddy only serves it.
{$TESEL_DOMAIN} {
	tls /certs/certificate.crt /certs/certificate.key
	import /etc/caddy/headers.caddy

	# The base map and its licence notice, copied from the upstream while there is internet
	# (refresh.sh).
	handle_path /maps/* {
		root * /srv/maps
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle {
		encode zstd gzip
		reverse_proxy tesel:8080
	}
}
