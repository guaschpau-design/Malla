# HTTPS for a command post. Its name resolves to the post only on the post's own Wi-Fi, so no
# certificate authority can reach it: the certificate comes from lego beforehand (DNS challenge)
# and Caddy only serves it.
{$TESELIA_DOMAIN} {
	tls /certs/certificates/{$TESELIA_DOMAIN}.crt /certs/certificates/{$TESELIA_DOMAIN}.key
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy teselia:8080
}
